# Private generated game code is checked, never embedded into this script.
if(NOT DEFINED PS2_VU_EXTRA_SOURCE OR NOT EXISTS "${PS2_VU_EXTRA_SOURCE}")
    message(FATAL_ERROR "VU extra source is missing; restore the verified generated inputs")
endif()
if(NOT DEFINED PS2_VU_EXTRA_MANIFEST OR NOT EXISTS "${PS2_VU_EXTRA_MANIFEST}")
    message(FATAL_ERROR "VU extra manifest is missing; verify and regenerate the native coverage manifest")
endif()
file(READ "${PS2_VU_EXTRA_MANIFEST}" _vu_manifest)
string(JSON _vu_schema ERROR_VARIABLE _vu_error GET "${_vu_manifest}" schema)
if(_vu_error OR NOT _vu_schema EQUAL 1)
    message(FATAL_ERROR "Invalid VU extra manifest schema")
endif()
string(JSON _vu_expected_hash ERROR_VARIABLE _vu_error GET "${_vu_manifest}" source_sha256)
if(_vu_error)
    message(FATAL_ERROR "Invalid VU extra manifest hash")
endif()
file(SHA256 "${PS2_VU_EXTRA_SOURCE}" _vu_actual_hash)
if(NOT _vu_actual_hash STREQUAL _vu_expected_hash)
    message(FATAL_ERROR "VU extra source hash differs from the verified coverage manifest; refusing a stale or partial native build")
endif()
string(JSON _vu_expected_count ERROR_VARIABLE _vu_error GET "${_vu_manifest}" program_count)
if(_vu_error OR NOT _vu_expected_count MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Invalid VU extra manifest program count")
endif()
file(READ "${PS2_VU_EXTRA_SOURCE}" _vu_source)
string(REGEX MATCHALL "void vu1_[0-9A-F]+\\(" _vu_functions "${_vu_source}")
list(LENGTH _vu_functions _vu_actual_count)
string(REGEX MATCH "register_programs\\(gen_extra::programs, ([0-9]+)\\)" _vu_registration "${_vu_source}")
set(_vu_registration_count "${CMAKE_MATCH_1}")
if(NOT _vu_actual_count EQUAL _vu_expected_count OR NOT _vu_registration_count STREQUAL _vu_expected_count)
    message(FATAL_ERROR "VU extra registration count differs from the verified coverage manifest")
endif()
message(STATUS "Verified ${_vu_expected_count} generated extra VU programs")
