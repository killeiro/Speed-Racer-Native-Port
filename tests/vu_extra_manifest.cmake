if(NOT DEFINED ROOT OR NOT DEFINED VERIFY)
    message(FATAL_ERROR "Test paths are required")
endif()
file(MAKE_DIRECTORY "${ROOT}")
set(_source "${ROOT}/extra.cpp")
set(_manifest "${ROOT}/manifest.json")
set(_good "void vu1_0000000000000001() {}\nvoid vu1_0000000000000002() {}\nvoid register_generated_vu_extra() { ps2::vu::register_programs(gen_extra::programs, 2); }\n")
file(WRITE "${_source}" "${_good}")
file(SHA256 "${_source}" _hash)
set(_valid "{\"schema\":1,\"source_sha256\":\"${_hash}\",\"program_count\":2}")
function(check expected label)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPS2_VU_EXTRA_SOURCE=${_source}" "-DPS2_VU_EXTRA_MANIFEST=${_manifest}" -P "${VERIFY}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(expected STREQUAL "pass" AND NOT _result EQUAL 0)
        message(FATAL_ERROR "${label} failed: ${_out}${_err}")
    elseif(expected STREQUAL "fail" AND _result EQUAL 0)
        message(FATAL_ERROR "${label} was incorrectly accepted")
    endif()
endfunction()
file(WRITE "${_manifest}" "${_valid}")
check(pass "valid source")
file(WRITE "${_source}" "void vu1_0000000000000001() {}\n")
check(fail "partial source")
file(WRITE "${_source}" "${_good}// accidental change\n")
check(fail "changed source")
file(WRITE "${_source}" "${_good}")
file(WRITE "${_manifest}" "{\"schema\":1,\"source_sha256\":\"${_hash}\",\"program_count\":3}")
check(fail "wrong count")
file(WRITE "${_source}" "void vu1_0000000000000001() {}\nvoid vu1_0000000000000002() {}\nvoid register_generated_vu_extra() { ps2::vu::register_programs(gen_extra::programs, 1); }\n")
file(SHA256 "${_source}" _bad_registration_hash)
file(WRITE "${_manifest}" "{\"schema\":1,\"source_sha256\":\"${_bad_registration_hash}\",\"program_count\":2}")
check(fail "wrong registration")
file(WRITE "${_source}" "${_good}")
file(WRITE "${_manifest}" "not JSON")
check(fail "invalid manifest")
file(REMOVE "${_manifest}")
check(fail "missing manifest")
file(WRITE "${_manifest}" "${_valid}")
file(REMOVE "${_source}")
check(fail "missing source")
file(WRITE "${_source}" "${_good}")
check(pass "restored verified source")
message(STATUS "VU coverage guard: 2 accepted / 7 rejected synthetic cases")
