# These are generated fixtures under the dedicated build test directory.
file(GLOB old_captures "${ROOT}/captures/*.bin")
file(GLOB old_sources "${ROOT}/generated/vu_cont_*.cpp")
if(old_captures)
    file(REMOVE ${old_captures})
endif()
if(old_sources)
    file(REMOVE ${old_sources})
endif()
execute_process(COMMAND "${FIXTURES}" "${ROOT}/captures" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "fixture generator failed")
endif()
execute_process(COMMAND "${RECOMP}" "${ROOT}/captures" "${ROOT}/generated" --continuations RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "continuation generation failed")
endif()
file(GLOB sources "${ROOT}/generated/vu_cont_*.cpp")
set(text "")
foreach(source IN LISTS sources)
    string(APPEND text "#include \"${source}\"\n")
endforeach()
file(WRITE "${ROOT}/generated.cpp" "${text}")
